    {
      "parameters": {
        "jsCode": "// n8n Code node (JavaScript) — wrap Markdown->HTML fragment into a styled full HTML document\n// + remove emojis/symbols that render as squares in PDF engines\n// Input expected: $json.data contains HTML fragment from \"Markdown to HTML\" node\n// Output: $json.fullHtml (use this in PDF Generator node: {{$json.fullHtml}})\n\nconst bodyRaw = $json.data || \"\";\n\n// Remove emojis/symbol characters (keeps normal text). Best option if your runtime supports Unicode property escapes.\nlet bodyClean;\ntry {\n  bodyClean = bodyRaw.replace(/[\\p{Extended_Pictographic}\\p{So}\\p{Sk}]/gu, \"\");\n} catch (e) {\n  // Fallback: remove only common emoji blocks (keeps most accented characters)\n  bodyClean = bodyRaw.replace(/[\\u2600-\\u27BF\\u{1F000}-\\u{1FAFF}]/gu, \"\");\n}\n\nconst now = new Date();\nconst yyyyMmDd = now.toISOString().slice(0, 10);\n\nconst fullHtml = `<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Weekly AI Intelligence Briefing</title>\n  <style>\n    body { font-family: Arial, sans-serif; margin: 28px; color: #111; }\n    .meta { font-size: 10px; color: #666; margin-bottom: 12px; }\n    h1 { font-size: 22px; margin: 0 0 12px; }\n    h2 { font-size: 14px; margin: 22px 0 8px; padding-top: 8px; border-top: 2px solid #ddd; }\n    p, li { font-size: 11.5px; line-height: 1.45; }\n    ul, ol { margin: 6px 0 12px 18px; }\n    li { margin-bottom: 10px; }\n    strong { font-weight: 700; }\n    em { color: #333; }\n    hr { border: 0; border-top: 1px solid #eee; margin: 16px 0; }\n\n    /* Page setup */\n    @page { size: A4; margin: 16mm; }\n    h2 { page-break-after: avoid; }\n    ul, ol, p { page-break-inside: avoid; }\n  </style>\n</head>\n<body>\n  <div class=\"meta\">Generated: ${yyyyMmDd} • Confidential • Weekly AI Intelligence Briefing</div>\n  ${bodyClean}\n</body>\n</html>`;\n\nreturn [{ json: { ...$json, fullHtml } }];"
      },
